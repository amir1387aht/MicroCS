config MICROCS
	bool "MicroCS C# runtime"
	select REQUIRES_FULL_LIBC
	help
	  MicroCS: run C# scripts on the device - REPL, filesystem, scheduler
	  and the GPIO/UART/I2C/SPI/ADC/DAC/PWM/Timer/CAN/Watchdog classes.

if MICROCS

config MICROCS_PORT
	bool "Zephyr board port (mcs_zephyr_hal_init)"
	default y
	select GPIO
	imply UART_INTERRUPT_DRIVEN
	imply UART_USE_RUNTIME_CONFIGURE
	imply HWINFO
	imply REBOOT

config MICROCS_USER_CONFIG_FILE
	string "Project config header (mcs_user_config.h)"
	default ""
	help
	  Path of the header with your MCS_* options (template:
	  config/mcs_user_config.h in MicroCS), absolute or relative to the
	  application folder. Empty: mcs_user_config.h in the application
	  folder, its include/ or src/ folder is used when it exists. NONE: no
	  config header. These Kconfig options win over the header, except the
	  profile: MCS_PROFILE in the header wins.

choice MICROCS_PROFILE_CHOICE
	prompt "MicroCS configuration profile"
	default MICROCS_PROFILE_AUTO
	help
	  Which include/profiles/mcs_profile_<name>.h configures the runtime.
	  AUTO picks one from CONFIG_SRAM_SIZE / CONFIG_FLASH_SIZE (16 KB RAM /
	  64 KB flash minimum; see include/profiles/mcs_profile_auto.h).
	  MCS_PROFILE in mcs_user_config.h overrides this choice.

config MICROCS_PROFILE_AUTO
	bool "Auto (from the board's RAM and flash size)"

config MICROCS_PROFILE_FULL
	bool "Full (everything on)"

config MICROCS_PROFILE_EMBEDDED
	bool "Embedded (on-device compiler + REPL, 96 KB+ RAM)"

config MICROCS_PROFILE_MCU
	bool "MCU (precompiled images, 64-96 KB RAM)"

config MICROCS_PROFILE_LOWRAM
	bool "Low-RAM (precompiled images, 32-64 KB RAM)"

config MICROCS_PROFILE_MIN
	bool "Minimum (64 KB flash / 16 KB RAM)"

endchoice

config MICROCS_HEAP_SIZE
	int "C# heap in bytes (example application)"
	default 98304 if ARCH_POSIX || SRAM_SIZE >= 192
	default 65536 if SRAM_SIZE >= 112
	default 40960
	help
	  Size of the static buffer the example application gives the VM.
	  Your own application may ignore it and pass any buffer.

config MICROCS_FS
	bool "Persistent files (LittleFS on the storage partition)"
	default y if FILE_SYSTEM_LITTLEFS
	depends on FILE_SYSTEM
	help
	  The example application mounts LittleFS on the board's
	  `storage_partition` at /lfs and runs /boot.cs, /jobs.cfg and /main.cs
	  from it; MicroCS Studio and tools/mcs_remote.py upload files there.
	  Without it a RAM filesystem of MICROCS_RAMFS_SIZE bytes is used.

config MICROCS_TINYFS
	bool "TinyFS (built in) instead of LittleFS for the persistent files"
	depends on FLASH_MAP
	help
	  The example application puts MicroCS's own small power-fail-safe
	  filesystem on `storage_partition` through mcs_zephyr_flash_area_init()
	  + mcs_flashfs_mount(). Nothing to download or link (MIT). Needs a
	  partition of at least two erase blocks. See overlay-tinyfs.conf.

config MICROCS_YAFFS2
	bool "YAFFS2 instead of LittleFS for the persistent files"
	depends on FLASH_MAP
	help
	  The example application puts YAFFS2 on `storage_partition` through
	  mcs_zephyr_flash_area_init() + mcs_flashfs_mount() instead of mounting
	  Zephyr's LittleFS. The yaffs2 sources are not bundled: pass
	  -DMICROCS_YAFFS2_DIR=<yaffs2 checkout>, keep one in the west
	  workspace (modules/fs/yaffs2) or the application (third_party/yaffs2),
	  or allow the pinned revision to be downloaded with
	  -DMICROCS_FS_DOWNLOAD=ON (cmake/MicroCSFS.cmake). YAFFS2 is GPLv2 (or
	  a commercial licence from Aleph One): linking it puts the firmware
	  under those terms. See overlay-yaffs2.conf.

config MICROCS_WS2812
	bool "WS2812 / NeoPixel driver (C# LedStrip on the led-strip alias)"
	default y
	help
	  The built-in "ws2812" driver: C# LedStrip drives the led_strip
	  device aliased `led-strip` in the devicetree (worldsemi,ws2812-spi,
	  -gpio, -i2s, -rpi_pico-pio ...). Needs CONFIG_LED_STRIP=y; without
	  the alias the class is not registered.

config MICROCS_SERVO
	bool "Servo driver (C# Servo on a PWM channel)"
	default y
	help
	  The built-in "servo" driver: C# Servo drives hobby servos and ESCs
	  with 50 Hz pulses on the board's PWM channels (the `pwms` of the
	  MicroCS PWM node). Turn it off to save ~3 KB of flash.

config MICROCS_THREADS
	bool "Real threads on Zephyr threads (C# Thread.Run / RunOn, SMP cores)"
	default n
	select DYNAMIC_THREAD
	select DYNAMIC_THREAD_ALLOC
	imply SCHED_CPU_MASK if SMP
	imply THREAD_NAME
	help
	  C# scripts and functions on their own Zephyr threads: Thread.Start,
	  Thread.Run, Thread.RunOn(cpu, ...) (pinned with CONFIG_SCHED_CPU_MASK
	  on SMP boards), Thread.Every for kernel-timed periodic work, Channels
	  between threads and `thread core=<n>` jobs in jobs.cfg. Every thread
	  has its own VM and heap (MCS_THREAD_HEAP) and a stack from the system
	  heap (CONFIG_HEAP_MEM_POOL_SIZE must hold MCS_THREADS_MAX stacks of
	  MCS_THREAD_STACK bytes; see overlay-threads.conf). Off: MicroCS stays
	  the single-threaded runtime. See docs/THREADS.md.

config MICROCS_RAMFS_SIZE
	int "RAM filesystem size when there is no persistent filesystem"
	default 16384

config MICROCS_CONSOLE_ECHO
	bool "Echo console input (raw UART terminals)"
	default y

endif
