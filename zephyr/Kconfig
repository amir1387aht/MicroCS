config MICROCS
	bool "MicroCS C# runtime"
	select REQUIRES_FULL_LIBC
	help
	  MicroCS: run C# scripts on the device - REPL, filesystem, scheduler
	  and the GPIO/UART/I2C/SPI/ADC/DAC/PWM/Timer/CAN/Watchdog classes.

if MICROCS

config MICROCS_PORT
	bool "Zephyr board port (mcs_zephyr_hal_init)"
	default y
	select GPIO
	imply UART_INTERRUPT_DRIVEN
	imply UART_USE_RUNTIME_CONFIGURE
	imply HWINFO
	imply REBOOT

choice MICROCS_PROFILE_CHOICE
	prompt "MicroCS configuration profile"
	default MICROCS_PROFILE_AUTO
	help
	  Which include/profiles/mcs_profile_<name>.h configures the runtime.
	  AUTO picks one from CONFIG_SRAM_SIZE / CONFIG_FLASH_SIZE (16 KB RAM /
	  64 KB flash minimum; see include/profiles/mcs_profile_auto.h).

config MICROCS_PROFILE_AUTO
	bool "Auto (from the board's RAM and flash size)"

config MICROCS_PROFILE_FULL
	bool "Full (everything on)"

config MICROCS_PROFILE_EMBEDDED
	bool "Embedded (on-device compiler + REPL, 96 KB+ RAM)"

config MICROCS_PROFILE_MCU
	bool "MCU (precompiled images, 64-96 KB RAM)"

config MICROCS_PROFILE_LOWRAM
	bool "Low-RAM (precompiled images, 32-64 KB RAM)"

config MICROCS_PROFILE_MIN
	bool "Minimum (64 KB flash / 16 KB RAM)"

endchoice

config MICROCS_HEAP_SIZE
	int "C# heap in bytes (example application)"
	default 98304 if ARCH_POSIX || SRAM_SIZE >= 192
	default 65536 if SRAM_SIZE >= 112
	default 40960
	help
	  Size of the static buffer the example application gives the VM.
	  Your own application may ignore it and pass any buffer.

config MICROCS_FS
	bool "Persistent files (LittleFS on the storage partition)"
	default y if FILE_SYSTEM_LITTLEFS
	depends on FILE_SYSTEM
	help
	  The example application mounts LittleFS on the board's
	  `storage_partition` at /lfs and runs /boot.cs, /jobs.cfg and /main.cs
	  from it; MicroCS Studio and tools/mcs_remote.py upload files there.
	  Without it a RAM filesystem of MICROCS_RAMFS_SIZE bytes is used.

config MICROCS_YAFFS2
	bool "YAFFS2 instead of LittleFS for the persistent files"
	depends on FLASH_MAP
	help
	  The example application puts YAFFS2 on `storage_partition` through
	  mcs_zephyr_flash_area_init() + mcs_flashfs_mount() instead of mounting
	  Zephyr's LittleFS. The yaffs2 sources are downloaded at build time
	  (pinned revision, cmake/MicroCSFS.cmake). YAFFS2 is GPLv2 (or a
	  commercial licence from Aleph One): linking it puts the firmware
	  under those terms. See overlay-yaffs2.conf.

config MICROCS_RAMFS_SIZE
	int "RAM filesystem size when there is no persistent filesystem"
	default 16384

config MICROCS_CONSOLE_ECHO
	bool "Echo console input (raw UART terminals)"
	default y

endif
