# MicroCS - optional LVGL 8.x / 9.x binding (docs/LVGL.md): C# calls the LVGL C API with the C names
# (lv_obj_create, LV_ALIGN_CENTER, lv_style_t...). MicroCS only finds LVGL's headers and lets you turn
# the binding on; YOU port LVGL (lv_init, display, input, lv_tick, lv_conf.h).
#
#   MICROCS_LVGL           ON: compile the LVGL binding in (default OFF, or ON when the project's
#                          mcs_user_config.h says  #define MCS_ENABLE_LVGL 1)
#   MICROCS_LVGL_DIR       the LVGL checkout (folder with lvgl.h, 8.0 ... 9.x); also the environment
#                          variables MICROCS_LVGL_DIR / LVGL_DIR. Without it: an existing `lvgl` /
#                          `lvgl::lvgl` CMake target (its source dir), then lvgl/, third_party/lvgl,
#                          lib/lvgl, libs/lvgl, external/lvgl, components/lvgl, managed_components/lvgl__lvgl
#                          in the project, ../lvgl next to MicroCS
#   MICROCS_LVGL_API_INC   a ready-made API table file (the all-versions mcs_lvgl_api.inc from the release
#                          artifacts or `python3 tools/lvgl_gen/build_api.py --all`): works with any 8.x/9.x
#                          and needs no Python. Default: tables generated for exactly the LVGL found
#                          (needs python3 + `pip install pycparser` + a C compiler on the build machine,
#                          runs once at configure time, ~20 s)
#   MICROCS_LVGL_BUILD     host build only (`mcs --lvgl`): compile LVGL itself with the lv_conf.h of
#                          tests/lvgl/v8|v9 and add the in-memory display (ports/unix/mcs_lvgl_host.c)
#   MICROCS_LVGL_FS_LETTER / MICROCS_LVGL_AUTO_HANDLER / MICROCS_LVGL_CLEANUP_ON_CLOSE   see mcs_config.h
#
# The binding is compiled with the project's own lv_conf.h: widgets that are disabled there are simply
# missing for scripts. Add your LVGL target before MicroCS (or pass MICROCS_LVGL_DIR) so the headers are found.

set(_MICROCS_LVGL_HERE ${CMAKE_CURRENT_LIST_DIR})

# ON when the project config header defines MCS_ENABLE_LVGL 1 or MICROCS_LVGL is ON
function(microcs_lvgl_wanted out config_file)
    set(_on OFF)
    if(MICROCS_LVGL)
        set(_on ON)
    elseif(NOT DEFINED MICROCS_LVGL AND config_file AND EXISTS "${config_file}")
        file(STRINGS "${config_file}" _l REGEX "^[ \t]*#[ \t]*define[ \t]+MCS_ENABLE_LVGL[ \t]+1")
        if(_l)
            set(_on ON)
        endif()
    endif()
    set(${out} ${_on} PARENT_SCOPE)
endfunction()

# MICROCS_LVGL_SRC (parent scope) = the LVGL checkout (folder with lvgl.h); stops with instructions if none
function(microcs_find_lvgl)
    set(_user "${MICROCS_LVGL_DIR}")
    foreach(e MICROCS_LVGL_DIR LVGL_DIR)
        if(NOT _user AND DEFINED ENV{${e}})
            set(_user "$ENV{${e}}")
        endif()
    endforeach()
    set(_found "")
    if(_user)
        get_filename_component(_user "${_user}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
        if(NOT EXISTS "${_user}/lvgl.h")
            message(FATAL_ERROR "MicroCS: MICROCS_LVGL_DIR=${_user} has no lvgl.h - point it at a checkout of https://github.com/lvgl/lvgl (8.0 ... 9.x)")
        endif()
        set(_found "${_user}")
    endif()
    if(NOT _found AND DEFINED ZEPHYR_LVGL_MODULE_DIR AND EXISTS "${ZEPHYR_LVGL_MODULE_DIR}/lvgl.h")
        set(_found "${ZEPHYR_LVGL_MODULE_DIR}")      # Zephyr's LVGL module (CONFIG_LVGL)
    endif()
    if(NOT _found)
        foreach(t lvgl lvgl::lvgl)
            if(NOT _found AND TARGET ${t})
                get_target_property(_aliased ${t} ALIASED_TARGET)
                if(_aliased)
                    set(t ${_aliased})
                endif()
                get_target_property(_sd ${t} SOURCE_DIR)
                if(_sd AND EXISTS "${_sd}/lvgl.h")
                    set(_found "${_sd}")
                endif()
            endif()
        endforeach()
    endif()
    if(NOT _found)
        foreach(d lvgl third_party/lvgl lib/lvgl libs/lvgl external/lvgl components/lvgl managed_components/lvgl__lvgl)
            if(NOT _found AND EXISTS "${CMAKE_SOURCE_DIR}/${d}/lvgl.h")
                set(_found "${CMAKE_SOURCE_DIR}/${d}")
            endif()
        endforeach()
        if(NOT _found AND EXISTS "${_MICROCS_LVGL_HERE}/../../lvgl/lvgl.h")
            get_filename_component(_found "${_MICROCS_LVGL_HERE}/../../lvgl" ABSOLUTE)
        endif()
    endif()
    if(NOT _found)
        message(FATAL_ERROR "MicroCS: LVGL is not bundled and was not found. Pass -DMICROCS_LVGL_DIR=<LVGL checkout> "
            "(git clone --depth 1 --branch v9.2.2 https://github.com/lvgl/lvgl), define the `lvgl` target before MicroCS, "
            "or put LVGL in lvgl/ next to your CMakeLists.txt (docs/LVGL.md)")
    endif()
    set(MICROCS_LVGL_SRC "${_found}" PARENT_SCOPE)
endfunction()

# MICROCS_LVGL_API_FILE (parent scope) = the table file for mcs_lvgl.c: MICROCS_LVGL_API_INC or one generated
# from `lvgl_dir` (re-generated when LVGL or the generator changes)
function(microcs_lvgl_api lvgl_dir)
    if(MICROCS_LVGL_API_INC)
        get_filename_component(_f "${MICROCS_LVGL_API_INC}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
        if(NOT EXISTS "${_f}")
            message(FATAL_ERROR "MicroCS: MICROCS_LVGL_API_INC=${_f} does not exist")
        endif()
        set(MICROCS_LVGL_API_FILE "${_f}" PARENT_SCOPE)
        return()
    endif()
    set(_gen ${_MICROCS_LVGL_HERE}/../tools/lvgl_gen)
    set(_out ${CMAKE_BINARY_DIR}/microcs_lvgl/mcs_lvgl_api.inc)
    set(_stamp ${CMAKE_BINARY_DIR}/microcs_lvgl/stamp.txt)
    set(_srcs ${_gen}/gen.py ${_gen}/extract.py ${_gen}/build_api.py)
    set(_sum "${lvgl_dir}")
    foreach(f ${_srcs} ${lvgl_dir}/lvgl.h ${lvgl_dir}/src/lv_version.h ${lvgl_dir}/src/core/lv_obj.h)
        if(EXISTS "${f}")
            file(SHA1 "${f}" _h)
            string(APPEND _sum " ${_h}")
        endif()
    endforeach()
    set(_old "")
    if(EXISTS "${_stamp}")
        file(READ "${_stamp}" _old)
    endif()
    if(NOT EXISTS "${_out}" OR NOT "${_old}" STREQUAL "${_sum}")
        set(_py ${MICROCS_PYTHON})
        if(NOT _py)
            find_program(_py NAMES python3 python)
        endif()
        if(NOT _py)
            message(FATAL_ERROR "MicroCS: python3 is needed once to generate the LVGL API tables (or pass -DMICROCS_LVGL_API_INC=<mcs_lvgl_api.inc>)")
        endif()
        message(STATUS "MicroCS: generating the LVGL API tables for ${lvgl_dir} (python3 + pycparser)")
        file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/microcs_lvgl)
        execute_process(COMMAND ${_py} ${_gen}/build_api.py --lvgl "${lvgl_dir}" --work ${CMAKE_BINARY_DIR}/microcs_lvgl/work --out "${_out}"
                        RESULT_VARIABLE _rc OUTPUT_VARIABLE _o ERROR_VARIABLE _e)
        if(NOT _rc EQUAL 0)
            message(FATAL_ERROR "MicroCS: LVGL API generation failed (needs `pip install pycparser` and a C compiler):\n${_o}${_e}")
        endif()
        file(WRITE "${_stamp}" "${_sum}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_srcs})
    set(MICROCS_LVGL_API_FILE "${_out}" PARENT_SCOPE)
endfunction()

# the cache-style options -> compile definitions
function(_microcs_lvgl_option_defs out)
    set(_d "")
    if(DEFINED MICROCS_LVGL_FS_LETTER AND NOT "${MICROCS_LVGL_FS_LETTER}" STREQUAL "")
        string(SUBSTRING "${MICROCS_LVGL_FS_LETTER}" 0 1 _c)
        list(APPEND _d "MCS_LVGL_FS_LETTER='${_c}'")
    endif()
    if(DEFINED MICROCS_LVGL_AUTO_HANDLER)
        if(MICROCS_LVGL_AUTO_HANDLER)
            list(APPEND _d MCS_LVGL_AUTO_HANDLER=1)
        else()
            list(APPEND _d MCS_LVGL_AUTO_HANDLER=0)
        endif()
    endif()
    if(DEFINED MICROCS_LVGL_CLEANUP_ON_CLOSE)
        if(MICROCS_LVGL_CLEANUP_ON_CLOSE)
            list(APPEND _d MCS_LVGL_CLEANUP_ON_CLOSE=1)
        else()
            list(APPEND _d MCS_LVGL_CLEANUP_ON_CLOSE=0)
        endif()
    endif()
    set(${out} ${_d} PARENT_SCOPE)
endfunction()

# plain CMake / pico-sdk / STM32: turn LVGL on for `target` (the microcs library)
function(microcs_add_lvgl target)
    microcs_find_lvgl()
    microcs_lvgl_api("${MICROCS_LVGL_SRC}")
    message(STATUS "MicroCS: LVGL binding on (${MICROCS_LVGL_SRC}, tables ${MICROCS_LVGL_API_FILE})")
    _microcs_lvgl_option_defs(_defs)
    target_compile_definitions(${target} PUBLIC MCS_ENABLE_LVGL=1 ${_defs})
    target_compile_definitions(${target} PRIVATE "MCS_LVGL_API_INC=\"${MICROCS_LVGL_API_FILE}\"")
    set(_linked OFF)
    foreach(t lvgl lvgl::lvgl)
        if(NOT _linked AND TARGET ${t})
            set(_t ${t})
            get_target_property(_aliased ${t} ALIASED_TARGET)
            if(_aliased)
                set(_t ${_aliased})
            endif()
            get_target_property(_sd ${_t} SOURCE_DIR)
            if(_sd AND EXISTS "${_sd}/lvgl.h")      # LVGL's own CMake target (not Zephyr's glue library)
                target_link_libraries(${target} PRIVATE ${t})    # headers + the project's lv_conf.h settings
                set(_linked ON)
            endif()
        endif()
    endforeach()
    if(NOT _linked)
        target_include_directories(${target} PRIVATE "${MICROCS_LVGL_SRC}")
    endif()
    set(MICROCS_LVGL_LINKED ${_linked} PARENT_SCOPE)
    set(MICROCS_LVGL_SRC "${MICROCS_LVGL_SRC}" PARENT_SCOPE)
    set(MICROCS_LVGL_API_FILE "${MICROCS_LVGL_API_FILE}" PARENT_SCOPE)
endfunction()

# host `mcs --lvgl`: compile LVGL itself (src/**/*.c) with the test lv_conf.h and the in-memory display
function(microcs_add_lvgl_host exe target)
    if(EXISTS "${MICROCS_LVGL_SRC}/src/display/lv_display.h")
        set(_api v9)
    else()
        set(_api v8)
    endif()
    if(NOT MICROCS_LVGL_CONF_DIR)
        set(MICROCS_LVGL_CONF_DIR ${_MICROCS_LVGL_HERE}/../tests/lvgl/${_api})
    endif()
    file(GLOB_RECURSE _srcs "${MICROCS_LVGL_SRC}/src/*.c")
    add_library(microcs_lvgl_lib STATIC ${_srcs})
    target_include_directories(microcs_lvgl_lib PUBLIC "${MICROCS_LVGL_CONF_DIR}" "${MICROCS_LVGL_SRC}" "${MICROCS_LVGL_SRC}/src")
    target_compile_definitions(microcs_lvgl_lib PUBLIC LV_CONF_INCLUDE_SIMPLE)
    target_compile_options(microcs_lvgl_lib PRIVATE -w -ffunction-sections -fdata-sections)
    target_include_directories(${target} PRIVATE "${MICROCS_LVGL_CONF_DIR}")
    target_compile_definitions(${target} PRIVATE LV_CONF_INCLUDE_SIMPLE)
    target_sources(${exe} PRIVATE ${_MICROCS_LVGL_HERE}/../ports/unix/mcs_lvgl_host.c)
    target_include_directories(${exe} PRIVATE "${MICROCS_LVGL_CONF_DIR}" "${MICROCS_LVGL_SRC}")
    target_compile_definitions(${exe} PRIVATE LV_CONF_INCLUDE_SIMPLE)
    target_link_libraries(${exe} PRIVATE microcs_lvgl_lib)
endfunction()
