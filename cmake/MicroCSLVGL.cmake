# Consume exactly one HOST target; never download/build another LVGL instance.
option(MICROCS_LVGL "Bind an already initialized host LVGL 8.x/9.x" OFF)
set(MICROCS_LVGL_TARGET "lvgl::lvgl" CACHE STRING "Existing host LVGL target (carries lv_conf.h and include/compile settings)")
set(MICROCS_LVGL_INCLUDE "" CACHE STRING "Optional LVGL header spelling, e.g. vendor/lvgl.h")
set(MICROCS_LVGL_DIR "" CACHE PATH "Optional additional directory containing the host LVGL header")
function(microcs_add_lvgl target)
    if(NOT TARGET "${MICROCS_LVGL_TARGET}")
        message(FATAL_ERROR "MicroCS LVGL: create the host LVGL 8.x/9.x target first and set MICROCS_LVGL_TARGET. Headers alone are insufficient; MicroCS never downloads or builds LVGL.")
    endif()
    target_link_libraries(${target} PUBLIC "${MICROCS_LVGL_TARGET}")
    target_compile_definitions(${target} PUBLIC MCS_ENABLE_LVGL=1)
    if(MICROCS_LVGL_DIR)
        target_include_directories(${target} PUBLIC "${MICROCS_LVGL_DIR}")
    endif()
    if(MICROCS_LVGL_INCLUDE)
        target_compile_definitions(${target} PUBLIC MCS_LVGL_INCLUDE="${MICROCS_LVGL_INCLUDE}")
    endif()
endfunction()
