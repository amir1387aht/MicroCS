# Optional LVGL. No dependency is downloaded or configuration rewritten.
# ROOT builds real upstream sources; TARGET links a firmware-supplied target;
# LIBRARY + INCLUDE_DIR link a prebuilt library. Explicit inputs win.
function(microcs_add_lvgl target)
    if(NOT MICROCS_LVGL_MAJOR MATCHES "^(8|9)$")
        message(FATAL_ERROR "MicroCS LVGL: select -DMICROCS_LVGL_MAJOR=8 or 9 explicitly")
    endif()
    set(_root "${MICROCS_LVGL_ROOT}")
    if(NOT _root AND DEFINED ENV{MICROCS_LVGL_ROOT})
        set(_root "$ENV{MICROCS_LVGL_ROOT}")
    endif()
    set(_inc "${MICROCS_LVGL_INCLUDE_DIR}")
    if(NOT _inc)
        set(_inc "${_root}")
    endif()
    if(NOT EXISTS "${_inc}/lvgl.h")
        message(FATAL_ERROR "MicroCS LVGL: missing lvgl.h; set MICROCS_LVGL_ROOT or MICROCS_LVGL_INCLUDE_DIR to the real upstream root/include directory. Headers alone do not supply a linked library.")
    endif()
    if(EXISTS "${_inc}/lv_version.h")
        file(READ "${_inc}/lv_version.h" _h)
    else()
        file(READ "${_inc}/lvgl.h" _h)
    endif()
    foreach(_part MAJOR MINOR PATCH)
        string(REGEX MATCH "#define[ \t]+LVGL_VERSION_${_part}[ \t]+([0-9]+)" _match "${_h}")
        if(NOT _match)
            message(FATAL_ERROR "MicroCS LVGL: cannot detect LVGL_VERSION_${_part} from actual headers in ${_inc}")
        endif()
        set(_${_part} "${CMAKE_MATCH_1}")
    endforeach()
    if(NOT _MAJOR STREQUAL MICROCS_LVGL_MAJOR)
        message(FATAL_ERROR "MicroCS LVGL: requested ${MICROCS_LVGL_MAJOR} but headers are ${_MAJOR}.${_MINOR}.${_PATCH}; no automatic version substitution")
    endif()
    if(NOT _MINOR EQUAL 4 OR NOT _PATCH EQUAL 0)
        message(FATAL_ERROR "MicroCS LVGL: this WIP adapter is validated against 8.4.0 / 9.4.0; found ${_MAJOR}.${_MINOR}.${_PATCH}. Validate and extend the compatibility contract first.")
    endif()
    get_filename_component(_conf "${MICROCS_LVGL_CONFIG}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    if(NOT MICROCS_LVGL_CONFIG OR NOT EXISTS "${_conf}")
        message(FATAL_ERROR "MicroCS LVGL: set MICROCS_LVGL_CONFIG to your existing lv_conf.h. It is never generated/rewritten silently; library and wrapper must use identical configuration.")
    endif()
    # v8 stringifies LV_CONF_PATH itself; v9 expects a C string literal.
    if(_MAJOR EQUAL 8)
        set(_conf_def "LV_CONF_PATH=${_conf}")
    else()
        set(_conf_def "LV_CONF_PATH=\"${_conf}\"")
    endif()
    if(MICROCS_LVGL_TARGET)
        if(NOT TARGET "${MICROCS_LVGL_TARGET}")
            message(FATAL_ERROR "MicroCS LVGL: MICROCS_LVGL_TARGET=${MICROCS_LVGL_TARGET} is not an existing CMake target")
        endif()
        set(_lib "${MICROCS_LVGL_TARGET}")
    elseif(MICROCS_LVGL_LIBRARY)
        if(NOT EXISTS "${MICROCS_LVGL_LIBRARY}")
            message(FATAL_ERROR "MicroCS LVGL: MICROCS_LVGL_LIBRARY does not exist")
        endif()
        set(_lib "${MICROCS_LVGL_LIBRARY}")
    elseif(_root AND EXISTS "${_root}/CMakeLists.txt")
        if(TARGET lvgl)
            message(FATAL_ERROR "MicroCS LVGL: lvgl target already exists; select MICROCS_LVGL_TARGET=lvgl explicitly")
        endif()
        # Scoped inherited options, not forced cache mutations of the user's project.
        # Upstream declares cache variables/options. Preserve explicit normal
        # values in this function's scope, including on a reconfigure.
        set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
        set(CMAKE_POLICY_DEFAULT_CMP0126 NEW)
        set(LV_CONF_PATH "${_conf}")
        set(LV_BUILD_CONF_PATH "${_conf}")
        set(CONFIG_LV_BUILD_DEMOS OFF)
        set(CONFIG_LV_BUILD_EXAMPLES OFF)
        set(CONFIG_LV_USE_THORVG_INTERNAL OFF)
        add_subdirectory("${_root}" "${CMAKE_BINARY_DIR}/microcs-lvgl" EXCLUDE_FROM_ALL)
        # v8's upstream CMake uses the directory but omits the custom filename definition.
        target_compile_definitions(lvgl PUBLIC "${_conf_def}")
        set(_lib lvgl)
    else()
        message(FATAL_ERROR "MicroCS LVGL: headers found but no linked library. Provide MICROCS_LVGL_ROOT with upstream sources, MICROCS_LVGL_TARGET, or MICROCS_LVGL_LIBRARY.")
    endif()
    target_include_directories(${target} PUBLIC "${_inc}")
    target_compile_definitions(${target} PUBLIC MCS_ENABLE_LVGL=1 MCS_LVGL_MAJOR=${_MAJOR} "${_conf_def}")
    target_link_libraries(${target} PUBLIC ${_lib})
    message(STATUS "MicroCS LVGL ${_MAJOR}.${_MINOR}.${_PATCH}: ${_inc}, config ${_conf}, library ${_lib}; no physical display inferred")
endfunction()
