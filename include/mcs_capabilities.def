MCS_CAP("Ble.Subscribe", CAP_BLE("Ble.Subscribe"), MCS_CAP_Ble_Subscribe)

MCS_CAP("Power", CAP_GLOBAL("Power"), MCS_CAP_Power)
MCS_CAP("Power.Sleep", CAP_GLOBAL("Power"), MCS_CAP_Power_Sleep)
MCS_CAP("Power.LightSleep", CAP_HW(h->power_enter && h->power_validate && (h->power_modes & MCS_POWER_LIGHT) && (h->power_modes & MCS_POWER_LIGHT)), MCS_CAP_Power_LightSleep)
MCS_CAP("Power.LightSleep.Timer", CAP_HW(h->power_enter && h->power_validate && (h->power_modes & MCS_POWER_LIGHT) && (h->power_timer_modes & MCS_POWER_LIGHT)), MCS_CAP_Power_LightSleep_Timer)
MCS_CAP("Power.LightSleep.Pin", CAP_HW(h->power_enter && h->power_validate && (h->power_modes & MCS_POWER_LIGHT) && (h->power_pin_modes & MCS_POWER_LIGHT)), MCS_CAP_Power_LightSleep_Pin)
MCS_CAP("Power.DeepSleep", CAP_HW(h->power_enter && h->power_validate && (h->power_modes & MCS_POWER_DEEP) && (h->power_modes & MCS_POWER_DEEP)), MCS_CAP_Power_DeepSleep)
MCS_CAP("Power.DeepSleep.Timer", CAP_HW(h->power_enter && h->power_validate && (h->power_modes & MCS_POWER_DEEP) && (h->power_timer_modes & MCS_POWER_DEEP)), MCS_CAP_Power_DeepSleep_Timer)
MCS_CAP("Power.DeepSleep.Pin", CAP_HW(h->power_enter && h->power_validate && (h->power_modes & MCS_POWER_DEEP) && (h->power_pin_modes & MCS_POWER_DEEP)), MCS_CAP_Power_DeepSleep_Pin)
MCS_CAP("Power.Shutdown", CAP_HW(h->power_enter && h->power_validate && (h->power_modes & MCS_POWER_SHUTDOWN) && (h->power_modes & MCS_POWER_SHUTDOWN)), MCS_CAP_Power_Shutdown)
MCS_CAP("Power.Shutdown.Pin", CAP_HW(h->power_enter && h->power_validate && (h->power_modes & MCS_POWER_SHUTDOWN) && (h->power_pin_modes & MCS_POWER_SHUTDOWN)), MCS_CAP_Power_Shutdown_Pin)
