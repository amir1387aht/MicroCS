/* Exact firmware capability vocabulary. Included with MCS_CAP(name, predicate).
 * Queries never enable radios or materialize lazy C# classes. */
MCS_CAP("Compiler", MCS_ENABLE_COMPILER != 0)
MCS_CAP("Float", MCS_ENABLE_FLOAT != 0)
MCS_CAP("Int64", MCS_INT64 != 0)
MCS_CAP("Math", CAP_GLOBAL("Math"))
MCS_CAP("Random", CAP_GLOBAL("Random"))
MCS_CAP("StringBuilder", CAP_GLOBAL("StringBuilder"))
MCS_CAP("List", CAP_GLOBAL("List"))
MCS_CAP("Dictionary", CAP_GLOBAL("Dictionary"))
MCS_CAP("Json", CAP_GLOBAL("Json"))
MCS_CAP("Encoding", CAP_GLOBAL("Encoding"))
MCS_CAP("BitConverter", CAP_GLOBAL("BitConverter"))
MCS_CAP("Convert", CAP_GLOBAL("Convert"))
MCS_CAP("GC", CAP_GLOBAL("GC"))
MCS_CAP("Stopwatch", CAP_GLOBAL("Stopwatch"))
MCS_CAP("HashSet", CAP_GLOBAL("HashSet"))
MCS_CAP("Queue", CAP_GLOBAL("Queue"))
MCS_CAP("Stack", CAP_GLOBAL("Stack"))
MCS_CAP("ArrayExtra", MCS_ENABLE_ARRAY_EXTRA != 0)
MCS_CAP("StringExtra", MCS_ENABLE_STRING_EXTRA != 0)
MCS_CAP("Format", MCS_ENABLE_FORMAT != 0)
MCS_CAP("Linq", MCS_ENABLE_LINQ && CAP_GLOBAL("Enumerable"))
MCS_CAP("Filesystem", MCS_ENABLE_FS && mcs_get_ext(vm, MCS_EXT_VFS) != NULL && CAP_GLOBAL("File"))
MCS_CAP("Scheduler", MCS_ENABLE_SCHED && mcs_get_ext(vm, MCS_EXT_SCHED) != NULL && CAP_GLOBAL("Scheduler"))
MCS_CAP("Threads", MCS_ENABLE_THREADS && CAP_GLOBAL("Thread"))
