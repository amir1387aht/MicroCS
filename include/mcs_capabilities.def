/* Exact firmware capability vocabulary. Included with MCS_CAP(name, predicate, id).
 * Queries never enable radios or materialize lazy C# classes. */
MCS_CAP("Compiler", MCS_ENABLE_COMPILER != 0, MCS_CAP_Compiler)
MCS_CAP("Float", MCS_ENABLE_FLOAT != 0, MCS_CAP_Float)
MCS_CAP("Int64", MCS_INT64 != 0, MCS_CAP_Int64)
MCS_CAP("Math", CAP_GLOBAL("Math"), MCS_CAP_Math)
MCS_CAP("Random", CAP_GLOBAL("Random"), MCS_CAP_Random)
MCS_CAP("StringBuilder", CAP_GLOBAL("StringBuilder"), MCS_CAP_StringBuilder)
MCS_CAP("List", CAP_GLOBAL("List"), MCS_CAP_List)
MCS_CAP("Dictionary", CAP_GLOBAL("Dictionary"), MCS_CAP_Dictionary)
MCS_CAP("Json", CAP_GLOBAL("Json"), MCS_CAP_Json)
MCS_CAP("Json.TryParse", MCS_ENABLE_JSON && MCS_ENABLE_LIST && MCS_ENABLE_DICT && CAP_GLOBAL("Json"), MCS_CAP_Json_TryParse)
MCS_CAP("Json.ComputedProperties", MCS_ENABLE_JSON && MCS_ENABLE_LIST && MCS_ENABLE_DICT && CAP_GLOBAL("Json"), MCS_CAP_Json_ComputedProperties)
MCS_CAP("Encoding", CAP_GLOBAL("Encoding"), MCS_CAP_Encoding)
MCS_CAP("BitConverter", CAP_GLOBAL("BitConverter"), MCS_CAP_BitConverter)
MCS_CAP("Convert", CAP_GLOBAL("Convert"), MCS_CAP_Convert)
MCS_CAP("GC", CAP_GLOBAL("GC"), MCS_CAP_GC)
MCS_CAP("Stopwatch", CAP_GLOBAL("Stopwatch"), MCS_CAP_Stopwatch)
MCS_CAP("HashSet", CAP_GLOBAL("HashSet"), MCS_CAP_HashSet)
MCS_CAP("Queue", CAP_GLOBAL("Queue"), MCS_CAP_Queue)
MCS_CAP("Stack", CAP_GLOBAL("Stack"), MCS_CAP_Stack)
MCS_CAP("ArrayExtra", MCS_ENABLE_ARRAY_EXTRA != 0, MCS_CAP_ArrayExtra)
MCS_CAP("StringExtra", MCS_ENABLE_STRING_EXTRA != 0, MCS_CAP_StringExtra)
MCS_CAP("Format", MCS_ENABLE_FORMAT != 0, MCS_CAP_Format)
MCS_CAP("Linq", MCS_ENABLE_LINQ && mcs_global_exists(vm, "Enumerable"), MCS_CAP_Linq)
MCS_CAP("Filesystem", MCS_ENABLE_FS && mcs_get_ext(vm, MCS_EXT_VFS) != NULL && mcs_global_exists(vm, "File"), MCS_CAP_Filesystem)
MCS_CAP("Filesystem.Streams", MCS_ENABLE_FILE_STREAMS && MCS_ENABLE_FS && mcs_get_ext(vm, MCS_EXT_VFS) != NULL && mcs_global_exists(vm, "FileStream"), MCS_CAP_Filesystem_Streams)
MCS_CAP("Scheduler", MCS_ENABLE_SCHED && mcs_get_ext(vm, MCS_EXT_SCHED) != NULL && CAP_GLOBAL("Scheduler"), MCS_CAP_Scheduler)
MCS_CAP("Threads", MCS_ENABLE_THREADS && mcs_global_exists(vm, "Thread"), MCS_CAP_Threads)
MCS_CAP("Board", CAP_HW(true), MCS_CAP_Board)
MCS_CAP("GPIO", CAP_HW(h->gpio_write != NULL), MCS_CAP_GPIO)
MCS_CAP("RotaryEncoder", MCS_ENABLE_ENCODER && CAP_HW(h->gpio_mode && h->gpio_read && ((h->gpio_capture && h->gpio_irq) || (MCS_ENABLE_ENCODER_HW && h->encoder_open && h->encoder_read && h->encoder_close))) && mcs_hal_events(vm) && CAP_GLOBAL("RotaryEncoder"), MCS_CAP_RotaryEncoder)
MCS_CAP("GPIO.IRQ", CAP_HW(h->gpio_irq != NULL), MCS_CAP_GPIO_IRQ)
MCS_CAP("GPIO.Configure", CAP_HW(h->gpio_configure != NULL), MCS_CAP_GPIO_Configure)
MCS_CAP("UART", CAP_HW(h->uart_write != NULL), MCS_CAP_UART)
MCS_CAP("UART.Configure", CAP_HW(h->uart_configure != NULL), MCS_CAP_UART_Configure)
MCS_CAP("I2C", CAP_HW(h->i2c_write != NULL), MCS_CAP_I2C)
MCS_CAP("I2C.Configure", CAP_HW(h->i2c_configure != NULL), MCS_CAP_I2C_Configure)
MCS_CAP("SPI", CAP_HW(h->spi_transfer != NULL), MCS_CAP_SPI)
MCS_CAP("SPI.Configure", CAP_HW(h->spi_configure != NULL), MCS_CAP_SPI_Configure)
MCS_CAP("ADC", CAP_HW(h->adc_read != NULL), MCS_CAP_ADC)
MCS_CAP("ADC.Configure", CAP_HW(h->adc_configure != NULL), MCS_CAP_ADC_Configure)
MCS_CAP("DAC", CAP_HW(h->dac_write != NULL), MCS_CAP_DAC)
MCS_CAP("PWM", CAP_HW(h->pwm_set != NULL || h->pwm_set16 != NULL), MCS_CAP_PWM)
MCS_CAP("PWM.Configure", CAP_HW(h->pwm_configure != NULL), MCS_CAP_PWM_Configure)
MCS_CAP("Timer", CAP_HW(h->timer_start != NULL), MCS_CAP_Timer)
MCS_CAP("I2S", CAP_HW(h->i2s_open != NULL), MCS_CAP_I2S)
MCS_CAP("QSPI", CAP_HW(h->qspi_command != NULL), MCS_CAP_QSPI)
MCS_CAP("QSPI.Configure", CAP_HW(h->qspi_configure != NULL), MCS_CAP_QSPI_Configure)
MCS_CAP("CAN", CAP_HW(h->can_send && h->can_recv && (h->can_open || h->can_configure)), MCS_CAP_CAN)
MCS_CAP("CAN.Configure", CAP_HW(h->can_configure != NULL), MCS_CAP_CAN_Configure)
MCS_CAP("CAN.Mcp2515", CAP_HW(MCS_ENABLE_MCP2515 && h->spi_transfer && h->spi_open && h->gpio_write && h->gpio_mode && h->delay_us), MCS_CAP_CAN_Mcp2515)
MCS_CAP("Watchdog", CAP_HW(h->wdt_start != NULL), MCS_CAP_Watchdog)
MCS_CAP("RTC", CAP_HW(h->rtc_get != NULL), MCS_CAP_RTC)
MCS_CAP("Micros", CAP_HW(h->micros != NULL), MCS_CAP_Micros)
MCS_CAP("Reset", CAP_HW(h->reset != NULL), MCS_CAP_Reset)
MCS_CAP("DMA", CAP_HW(MCS_ENABLE_HAL_DMA && (h->dma_channels > 0 || h->dma_copy || h->spi_transfer_async || h->i2c_transfer_async || h->uart_write_async || h->uart_read_async || h->qspi_command_async)), MCS_CAP_DMA)
MCS_CAP("DMA.Memory", CAP_HW(MCS_ENABLE_HAL_DMA && (h->dma_copy != NULL)), MCS_CAP_DMA_Memory)
MCS_CAP("DMA.SPI", CAP_HW(MCS_ENABLE_HAL_DMA && (h->spi_transfer_async != NULL)), MCS_CAP_DMA_SPI)
MCS_CAP("DMA.I2C", CAP_HW(MCS_ENABLE_HAL_DMA && (h->i2c_transfer_async != NULL)), MCS_CAP_DMA_I2C)
MCS_CAP("DMA.UART", CAP_HW(MCS_ENABLE_HAL_DMA && (h->uart_write_async != NULL || h->uart_read_async != NULL)), MCS_CAP_DMA_UART)
MCS_CAP("DMA.QSPI", CAP_HW(MCS_ENABLE_HAL_DMA && (h->qspi_command_async != NULL)), MCS_CAP_DMA_QSPI)
MCS_CAP("Drivers", CAP_GLOBAL("Drivers"), MCS_CAP_Drivers)
MCS_CAP("Dma", CAP_GLOBAL("Dma"), MCS_CAP_Dma)
MCS_CAP("DmaBuffer", CAP_GLOBAL("DmaBuffer"), MCS_CAP_DmaBuffer)
MCS_CAP("Servo", CAP_GLOBAL("Servo"), MCS_CAP_Servo)
MCS_CAP("LedStrip", CAP_GLOBAL("LedStrip"), MCS_CAP_LedStrip)
MCS_CAP("U8g2", CAP_GLOBAL("U8g2"), MCS_CAP_U8g2)
MCS_CAP("U8x8", CAP_GLOBAL("U8x8"), MCS_CAP_U8x8)
MCS_CAP("Net", CAP_NET("Net"), MCS_CAP_Net)
MCS_CAP("Sockets", CAP_NET("Sockets"), MCS_CAP_Sockets)
MCS_CAP("TcpClient", CAP_NET("TcpClient"), MCS_CAP_TcpClient)
MCS_CAP("TcpListener", CAP_NET("TcpListener"), MCS_CAP_TcpListener)
MCS_CAP("UdpClient", CAP_NET("UdpClient"), MCS_CAP_UdpClient)
MCS_CAP("Dns", CAP_NET("Dns"), MCS_CAP_Dns)
MCS_CAP("Http", CAP_NET("Http"), MCS_CAP_Http)
MCS_CAP("Http.Json", MCS_ENABLE_JSON && MCS_ENABLE_LIST && MCS_ENABLE_DICT && CAP_NET("Http") && CAP_GLOBAL("Json"), MCS_CAP_Http_Json)
MCS_CAP("HttpServer", CAP_NET("HttpServer"), MCS_CAP_HttpServer)
MCS_CAP("WebSocket", CAP_NET("WebSocket"), MCS_CAP_WebSocket)
MCS_CAP("DnsServer", CAP_NET("DnsServer"), MCS_CAP_DnsServer)
MCS_CAP("Wifi", CAP_NET("Wifi"), MCS_CAP_Wifi)
MCS_CAP("Wifi.AP", CAP_NET("Wifi.AP"), MCS_CAP_Wifi_AP)
MCS_CAP("Wifi.Scan", CAP_NET("Wifi.Scan"), MCS_CAP_Wifi_Scan)
MCS_CAP("Wifi.Save", CAP_NET("Wifi.Save"), MCS_CAP_Wifi_Save)
MCS_CAP("Wifi.Enterprise", CAP_NET("Wifi.Enterprise"), MCS_CAP_Wifi_Enterprise)
MCS_CAP("Wifi.Wps", CAP_NET("Wifi.Wps"), MCS_CAP_Wifi_Wps)
MCS_CAP("Wifi.SmartConfig", CAP_NET("Wifi.SmartConfig"), MCS_CAP_Wifi_SmartConfig)
MCS_CAP("EspNow", CAP_NET("EspNow"), MCS_CAP_EspNow)
MCS_CAP("Mdns", CAP_NET("Mdns"), MCS_CAP_Mdns)
MCS_CAP("Ping", CAP_NET("Ping"), MCS_CAP_Ping)
MCS_CAP("Tls", CAP_NET("Tls"), MCS_CAP_Tls)
MCS_CAP("Ntp", CAP_NET("Ntp"), MCS_CAP_Ntp)
MCS_CAP("Ntp.Sntp", CAP_NET("Ntp.Sntp"), MCS_CAP_Ntp_Sntp)
MCS_CAP("Ble", CAP_BLE("Ble"), MCS_CAP_Ble)
MCS_CAP("Ble.Advertise", CAP_BLE("Ble.Advertise"), MCS_CAP_Ble_Advertise)
MCS_CAP("Ble.Scan", CAP_BLE("Ble.Scan"), MCS_CAP_Ble_Scan)
MCS_CAP("Ble.ScanParameters", CAP_BLE("Ble.ScanParameters"), MCS_CAP_Ble_ScanParameters)
MCS_CAP("Ble.Server", CAP_BLE("Ble.Server"), MCS_CAP_Ble_Server)
MCS_CAP("Ble.Central", CAP_BLE("Ble.Central"), MCS_CAP_Ble_Central)
